# Risk V2 at 4h for the B2 / BTC paper session — NOT deployed, not launched.
#
# The JSON values are single-quoted so the file works BOTH ways: read directly by
# pydantic-settings, and sourced into a shell with `set -a; . this-file; set +a`. Unquoted,
# the shell strips the inner double quotes and the platform refuses to parse "risk".
#
# Every risk number is produced by risk_for_timeframe(deployed_risk_v2_1h, H4), the
# conversion M15 declared and every M22/M23/M24 run used. tests/unit/test_paper_b2_config.py
# loads this file, lets the platform build its RiskConfiguration from it, and compares that
# object field by field with the conversion. Editing a number here fails the suite.
#
# Note the names: settings expose RiskSettings, whose field names differ from
# RiskConfiguration's. max_volatility is MAX_REALIZED_VOLATILITY_FRACTION here, the risk
# budget is flat rather than nested, and market_buy_buffer_bps is not exposed at all.

# price distance, scaled by sqrt(4): a 4h bar moves twice a 1h bar (1h: 300)
QP_RISK__INITIAL_STOP_DISTANCE_BPS=600

# price distance, same sqrt(4) scaling (1h: 600)
QP_RISK__TAKE_PROFIT_DISTANCE_BPS=1200

# price distance, same sqrt(4) scaling (1h: 150)
QP_RISK__BREAK_EVEN_ACTIVATION_BPS=300

# held constant in TIME: 168 hourly bars = 7 days = 42 bars of 4h
QP_RISK__MAX_HOLDING_BARS=42

# a per-bar rate, so it scales with the bar (1h: 0.15). Settings calls it this, not max_volatility
QP_RISK__MAX_REALIZED_VOLATILITY_FRACTION=0.3000

# account-level, nothing per-bar about it: unchanged
QP_RISK__MAX_TOTAL_DRAWDOWN_FRACTION=0.20

# calendar-day limit: unchanged
QP_RISK__MAX_DAILY_DRAWDOWN_FRACTION=0.05

# calendar-day limit: unchanged
QP_RISK__MAX_DAILY_LOSS_PCT=0.03

# counts trades not bars: unchanged, and it LATCHES, exactly as production
QP_RISK__MAX_CONSECUTIVE_LOSSES=5

# the drawdown breaker latches, exactly as production
QP_RISK__LATCH_TOTAL_DRAWDOWN=True

# venue quality gate: unchanged
QP_RISK__MAX_SPREAD_BASIS_POINTS=25

# one at a time, as every backtest ran
QP_RISK__MAX_OPEN_POSITIONS=1

# one at a time
QP_RISK__MAX_OPEN_ORDERS=1

# unchanged
QP_RISK__MAX_DAILY_ORDERS=20

# unchanged
QP_RISK__MAX_HOURLY_ORDERS=5

# unchanged
QP_RISK__MAX_EXPOSURE_FRACTION=0.95

# a FRACTION OF EQUITY, not a price distance: it does not scale, or every position doubles
QP_RISK__RISK_PER_TRADE_PCT=0.01

# unchanged
QP_RISK__MAX_POSITION_EXPOSURE_PCT=0.50

# price distance, scaled (1h: 50)
QP_RISK__MIN_STOP_DISTANCE_BPS=100

# price distance, scaled (1h: 1000)
QP_RISK__MAX_STOP_DISTANCE_BPS=2000

# costs: exactly what the backtests paid (fees 10bps, slippage 5bps, spread 2bps)
QP_BACKTEST__COMMISSION_BASIS_POINTS=10
QP_BACKTEST__SLIPPAGE_BASIS_POINTS=5
QP_BACKTEST__SPREAD_BASIS_POINTS=2
QP_BACKTEST__INITIAL_CAPITAL=10000

# the market, and the allow-list the validator checks it against
QP_MARKET__SYMBOL=BTC/USDT
QP_MARKET__TIMEFRAME=4h
QP_RISK__ALLOWED_SYMBOLS='["BTC/USDT"]'

# paper only, live off
QP_EXECUTION_MODE=paper
QP_LIVE_TRADING_ENABLED=false

# the session, isolated: SessionLock holds one session per state directory
QP_PAPER__SESSION_ID=paper-b2-btc-4h-w1
QP_PAPER__SYMBOLS='["BTC/USDT"]'
QP_PAPER__TIMEFRAME=4h
QP_PAPER__STRATEGY_ID=breakout_trend
QP_PAPER__STRATEGY_PARAMS='{"entry_lookback":"40","exit_lookback":"20","trend_period":"400"}'
QP_PAPER__STATE_DIRECTORY=var/sessions/paper-b2-btc-4h-w1/state
QP_PAPER__LOG_DIRECTORY=var/sessions/paper-b2-btc-4h-w1/logs
QP_PAPER__REPORTS_DIRECTORY=var/sessions/paper-b2-btc-4h-w1/reports
