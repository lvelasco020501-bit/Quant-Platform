# Mission Control for the B2 / BTC / 4h session — read-only observer, second instance.
#
# A second instance rather than a repointing: :8800 watches the productive 1h session and
# must keep watching it. This one sees only /var/quant-platform-b2 and knows nothing about
# the other tree.
#
# Deliberately minimal, exactly as :8800: no database DSN, no exchange credentials, no
# live-trading variables. Not named .env, so the platform Settings this process builds does
# not try to validate MISSION_CONTROL_* keys as its own.

MISSION_CONTROL_HOST=100.65.149.67
MISSION_CONTROL_PORT=8801

# Deliberately unset: describe whichever session holds the lock in the directory below.
# Pinning a name is what once made a page show a finished run under a live run banner.
# MISSION_CONTROL_SESSION_ID=
MISSION_CONTROL_STATE_DIRECTORY=/var/quant-platform-b2/state
MISSION_CONTROL_REPORTS_DIRECTORY=/var/quant-platform-b2/reports
MISSION_CONTROL_LOG_DIRECTORY=/var/quant-platform-b2/logs
MISSION_CONTROL_REFRESH_SECONDS=12

# What the session is running, so the page can label it and size the warm-up. These are
# load-bearing here, not decoration: the warm-up requirement is derived from the configured
# instance (b4eefa9), so without the parameters the page falls back to the class default of
# 200 and says so. With them it reads 400, which is what this session actually needs.
QP_PAPER__STRATEGY_ID=breakout_trend
QP_PAPER__STRATEGY_PARAMS={"entry_lookback":"40","exit_lookback":"20","trend_period":"400"}
QP_PAPER__TIMEFRAME=4h
QP_MARKET__TIMEFRAME=4h
QP_RISK__RISK_PER_TRADE_PCT=0.01
QP_RISK__MAX_POSITION_EXPOSURE_PCT=0.50
QP_RISK__MIN_STOP_DISTANCE_BPS=100
QP_RISK__MAX_STOP_DISTANCE_BPS=2000
QP_RISK__INITIAL_STOP_DISTANCE_BPS=600
