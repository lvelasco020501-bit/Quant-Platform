# Quant platform configuration.
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# Every variable is optional: the defaults below are the ones the platform ships with.
#
# Nested sections use a double underscore: QP_<SECTION>__<FIELD>.

# --- Application ----------------------------------------------------------------------
QP_ENVIRONMENT=development
# backtest | paper | shadow | live   (live also requires the two variables below)
QP_EXECUTION_MODE=paper
QP_LOG_LEVEL=INFO
QP_LOG_FORMAT=json

# --- Live trading authorisation --------------------------------------------------------
# Live execution is refused unless ALL of the following hold:
#   QP_EXECUTION_MODE=live
#   QP_LIVE_TRADING_ENABLED=true
#   QP_LIVE_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING_RISK
#   exchange credentials are present
#   QP_ENVIRONMENT is not "development"
QP_LIVE_TRADING_ENABLED=false
# QP_LIVE_CONFIRMATION=

# --- Market -----------------------------------------------------------------------------
QP_MARKET__SYMBOL=BTC/USDT
QP_MARKET__BASE_ASSET=BTC
QP_MARKET__QUOTE_ASSET=USDT
QP_MARKET__MARKET_TYPE=spot
QP_MARKET__TIMEFRAME=1h

# --- Risk limits -------------------------------------------------------------------------
QP_RISK__ALLOW_SHORT=false
QP_RISK__ALLOW_LEVERAGE=false
QP_RISK__MAX_OPEN_POSITIONS=1
QP_RISK__MAX_OPEN_ORDERS=1
QP_RISK__MAX_EXPOSURE_FRACTION=0.95
QP_RISK__TARGET_POSITION_FRACTION=0.95
QP_RISK__MAX_DAILY_ORDERS=20
QP_RISK__MAX_HOURLY_ORDERS=5
QP_RISK__MAX_DAILY_DRAWDOWN_FRACTION=0.05
QP_RISK__MAX_TOTAL_DRAWDOWN_FRACTION=0.20
QP_RISK__MAX_SPREAD_BASIS_POINTS=25
QP_RISK__MAX_REALIZED_VOLATILITY_FRACTION=0.15
QP_RISK__MAX_CONSECUTIVE_API_FAILURES=3
QP_RISK__DATA_STALENESS_MULTIPLIER=1.5
QP_RISK__REQUIRE_RECONCILIATION=true

# --- Exchange ------------------------------------------------------------------------------
QP_EXCHANGE__NAME=binance
QP_EXCHANGE__TESTNET=true
QP_EXCHANGE__REQUEST_TIMEOUT_SECONDS=10
QP_EXCHANGE__MAX_RETRIES=3
# Secrets: never commit real values. Live keys must have withdrawals and transfers
# disabled, carry the minimum permissions required to trade, be IP-restricted where the
# venue supports it, and be distinct from any paper or testnet credentials.
# QP_EXCHANGE__API_KEY=
# QP_EXCHANGE__API_SECRET=

# --- Database --------------------------------------------------------------------------------
QP_DATABASE__DSN=postgresql+psycopg://quant:quant@localhost:5432/quantplatform
QP_DATABASE__POOL_SIZE=5
QP_DATABASE__MAX_OVERFLOW=5

# --- Data ingestion --------------------------------------------------------------------------
QP_DATA__CSV_DELIMITER=,
QP_DATA__CSV_ENCODING=utf-8
QP_DATA__CLOSE_GRACE_PERIOD_SECONDS=0
QP_DATA__GAP_SEVERITY=warning
QP_DATA__MAX_ALLOWED_GAP_BARS=24
QP_DATA__MAX_DATA_AGE_MULTIPLIER=2
# QP_DATA__HISTORICAL_BACKFILL_END=2026-01-01T00:00:00+00:00
QP_DATA__BATCH_SIZE=1000
QP_DATA__DEFAULT_SOURCE_ID=csv_historical

# --- Backtest assumptions ----------------------------------------------------------------------
QP_BACKTEST__INITIAL_CAPITAL=10000
QP_BACKTEST__COMMISSION_BASIS_POINTS=10
QP_BACKTEST__SPREAD_BASIS_POINTS=2
QP_BACKTEST__SLIPPAGE_BASIS_POINTS=5
QP_BACKTEST__LATENCY_BARS=0
QP_BACKTEST__RANDOM_SEED=42

# --- Monitoring --------------------------------------------------------------------------------
QP_MONITORING__HEARTBEAT_SECONDS=60
QP_MONITORING__RECONCILIATION_INTERVAL_SECONDS=300
QP_MONITORING__MAX_CLOCK_SKEW_SECONDS=2
QP_MONITORING__ALERT_MIN_SEVERITY=warning
